{
  "name": "@helix/desktop",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Helix, the desktop app (macOS, Windows, Linux): Electron shell that starts the server and opens a window on it",
  "author": "chaotyc",
  "homepage": "https://github.com/chaotyc/Helix",
  "desktopName": "helix.desktop",
  "main": "build/main.mjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/build.mjs && electron .",
    "dist": "node scripts/build.mjs && electron-builder --config electron-builder.config.mjs --publish never",
    "dist:mac": "node scripts/build.mjs && electron-builder --config electron-builder.config.mjs --publish never --mac --arm64 --x64",
    "dist:win": "node scripts/build.mjs && electron-builder --config electron-builder.config.mjs --publish never --win --x64",
    "dist:linux": "node scripts/build.mjs && electron-builder --config electron-builder.config.mjs --publish never --linux --x64",
    "icon": "sh scripts/make-icon.sh"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2"
  }
}
