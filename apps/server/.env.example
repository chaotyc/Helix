# Copy this file to .env (same folder) and put your keys after the = signs.
# .env is gitignored, so keys never get committed. Only the providers you use need a key.
# Subscriptions (Claude Code, Codex, Antigravity, Grok CLI, Muse Code) need no key here: sign in
# with the tool itself, and pick its models in the settings tab.

# https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# https://console.x.ai
XAI_API_KEY=
# https://dev.meta.ai (Model API dashboard → API keys)
META_API_KEY=
